# ===== 运行时 =====
# production 时缺 JWT_SECRET 会拒绝启动（见 common/startup-guards.ts）
NODE_ENV=development
PORT=4000
# CORS 白名单（逗号分隔）；留空或 * = 放行所有来源（桌面端 file:// 形态所需）
CORS_ORIGIN=

# ===== 数据库 =====
DATABASE_URL=mysql://servicedesk:servicedesk@localhost:3306/servicedesk

# ===== 认证与成员 =====
# 生产必须设置强随机值；切勿使用开发兜底值
JWT_SECRET=
# 开放自助注册：false = 账号仅由管理员在「设置-成员管理」开通（企业引入推荐）
OPEN_REGISTRATION=false
# 首启管理员引导：仅空库时生效一次，密码至少 8 位，留空则不创建
BOOTSTRAP_ADMIN_EMAIL=default@example.com
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=

# ===== LLM（OpenAI 兼容服务：DeepSeek / Ollama / GLM 等） =====
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=
# 决策模型（工具选择/填参）；留空沿用生成模型
LLM_DECISION_MODEL=
# 备用模型（逗号分隔）：主模型重试耗尽后依次降级
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# ===== 嵌入 / 重排（留空回退 LLM_* 配置） =====
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 检索 =====
RAG_MIN_SCORE=0.25
RAG_INDEX_TTL_MS=300000
KNOWLEDGE_MAX_UPLOAD_MB=20

# ===== Agent =====
# on = AgentRun 轨迹落库（看板/评测归因）；off = 不落
AGENT_TRACE=on
# HITL 建单确认门：有界等待时长 / 轮询间隔
CONFIRM_WAIT_TIMEOUT_MS=300000
CONFIRM_WAIT_POLL_MS=500
# 每用户每日 token 预算；0 或留空 = 不限
USER_DAILY_TOKEN_BUDGET=0
# 每用户并发在途流上限
MAX_CONCURRENT_STREAMS_PER_USER=2

# ===== 限流 =====
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=600

# ===== 通知与 SLA 预警 =====
# SLA 扫描间隔（ms）：扫未完结工单，濒临违约/违约时推送站内通知（口径与看板一致：剩余 <= 窗口 25%）
SLA_SCAN_INTERVAL_MS=300000
