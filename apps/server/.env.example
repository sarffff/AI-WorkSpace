# ===== 数据库 =====
DATABASE_URL="mysql://root:password@localhost:3306/ai_workspace"

# ===== 服务 =====
PORT=3000

# ===== LLM（对话/生成，OpenAI 兼容）=====
LLM_API_KEY=your-llm-api-key
LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_MODEL=glm-4.5-air
# 逗号分隔的可用模型列表（前端模型选择器）
LLM_MODELS=glm-4.5-air,glm-4.5,glm-4-flash

# ===== Embedding（OpenAI 兼容；留空则复用 LLM_* 配置）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 安全 =====
JWT_SECRET=please-change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# 允许的跨域来源（逗号分隔；默认放行 localhost 与无 Origin 的原生客户端）
ALLOWED_ORIGINS=

# ===== 可选：生产环境必须显式设置 =====
NODE_ENV=development