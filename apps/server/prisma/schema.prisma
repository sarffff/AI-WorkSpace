datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String?
  password   String
  avatar     String?
  department String? // 所属部门（权限过滤检索的依据）
  role       String   @default("employee") // employee 普通员工 | agent 服务台坐席 | admin 管理员
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  chats       Chat[]
  settings    Setting[]
  documents   Document[]
  prompts     Prompt[]
  ticketsCreated  Ticket[] @relation("TicketCreator")
  ticketsAssigned Ticket[] @relation("TicketAssignee")
  ticketComments  TicketComment[] @relation("TicketCommentAuthor")
  memories        Memory[]
}

// 跨会话长期记忆：用户偏好/关键事实/工单记录，会话开始时注入上下文
model Memory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // preference 偏好 | fact 事实 | ticket 工单记录
  content   String   @db.VarChar(255)
  chatId    String? // 来源会话（溯源，不建外键）
  embedding Json? // 记忆内容向量，用于按当前问题相关性召回；为空则回退按 updatedAt 排序
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category])
  @@unique([userId, category, content])
}

model Chat {
  id               String    @id @default(uuid())
  title            String
  pinned           Boolean   @default(false)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary          String? // 早期对话压缩摘要（token 裁剪的配套，后台异步生成）
  summaryAnchorId  String? // 摘要覆盖到的最后一条消息 id（生成锚点，避免重复总结）
  messages         Message[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Message {
  id               String   @id @default(uuid())
  content          String   @db.Text
  role             String   // user, assistant, system
  model            String?
  sources          Json? // RAG 引用溯源（命中片段 + 得分 + 来源文档）
  // 对话附件元数据（仅 user 消息）：[{id,name,size,mimeType}] 供前端渲染芯片；
  // 字节在磁盘（ChatAttachment 行 + chat-attachment store），正文注入只进 LLM 上下文不落库
  attachments      Json?
  promptTokens     Int? // 本次回答全部 LLM 调用的输入 token 数（工具循环/生成，不含后台摘要）
  completionTokens Int? // 输出 token 数
  // 答案满意度反馈（仅 assistant 消息）：up | down，NULL 为未评价。
  // 负例连同 feedbackReason 经 eval:collect 导出为评测候选用例。
  feedback         String?
  feedbackReason   String? // 仅 down 时可选：wrong | unsolved | bad_citation | irrelevant
  feedbackAt       DateTime?
  chatId           String
  chat             Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([feedback, feedbackAt])
  // (chatId, createdAt)：历史加载按会话取再按时间排；更关键的是每日 token 预算那条 SUM ——
  // 每个提问跑一次，条件是 chatId IN (该用户会话) AND createdAt >= 今日 0 点。
  // 只有单列 chatId 索引时会把整个会话的消息全捞出来再筛时间窗，会话越长越贵
  @@index([chatId, createdAt])
}

// 工单域：AI 无法自动解决时升级人工，构成服务台闭环
model Ticket {
  id         String    @id @default(uuid())
  title      String
  content    String    @db.Text
  status     String    @default("open") // open 待处理 | processing 处理中 | resolved 已解决 | closed 已关闭
  priority   String    @default("normal") // low | normal | high | urgent
  // 工单分类（建单时由 Agent 判定，坐席可纠正）：分类分布统计与后续自动派单的路由依据
  // account 账号权限 | hardware 硬件设备 | network 网络访问 | software 软件应用 | process 制度流程 | other 其他
  category   String    @default("other")
  creatorId  String
  creator    User      @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  source     String    @default("manual") // manual 手动创建 | agent AI 对话升级（偏转率统计依据）
  // 归属会话：AI 升级的工单是从哪次对话产生的。偏转率的分子要靠它，而 AgentRun 是观测
  // 副作用（AGENT_TRACE=off 就不落），业务事实不该寄生在可关的开关上。
  // 不建外键：会话可被用户删除，删掉会话不该抹掉工单的归属痕迹（统计要能追溯到历史）
  chatId     String?
  // SLA 到期时刻：建单时按优先级阈值（urgent 4h/high 8h/normal 24h/low 48h）从创建时间折算，
  // 优先级变更时对未完结工单重算。看板据此在「违约之前」预警，而不是只在事后统计达标率。
  // 可空：迁移前的历史工单为 NULL（视作"未排期"，不参与违约判定，单列计数摆出来）。
  dueAt      DateTime?
  // SLA 通知阶段：null 未通知 | at_risk 已发濒临违约预警 | breached 已发违约通知。
  // 定时扫描器据此保证每个阶段只推一次；工单完结后不再推进。
  slaNotifyStage String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([creatorId])
  @@index([assigneeId])
  @@index([chatId])
  // (status, updatedAt) 同时服务坐席列表的 ORDER BY status asc, updatedAt desc 与
  // 「status IN (open, processing)」的积压分组；左前缀就是 status，
  // 原单列 @@index([status]) 因此冗余，已一并去掉（少一个索引少一次写放大）
  @@index([status, updatedAt])
  // SLA 统计按 createdAt >= since 取区间，此前无索引即全表扫
  @@index([createdAt])
  @@index([category])
  comments TicketComment[]
  attachments TicketAttachment[]
}

// 工单附件：IT 支持里截图/日志/配置是第一现场证据。字节落盘（与知识库上传同一思路），
// 这里只存元数据。uploaderId 不建外键（与 chatId 一致的实用取舍）：删用户不该连带抹掉
// 工单证据；文件随工单删除级联清理（DB 行 onDelete Cascade，磁盘副本由服务端一并删）。
model TicketAttachment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploaderId String
  filename   String // 原始文件名（展示与下载用）
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

// 工单时间线：坐席与创建者的往来评论 + 状态流转/受理/转派的系统事件自动记录
model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  kind      String   @default("comment") // comment 用户评论 | system 系统事件（自动写入）
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// HITL 建单确认草稿：Agent 建单前的待确认请求持久化，SSE 断连后仍可异步确认/拒绝。
// requestId 沿用 `${chatId}:${ts}:${rand}` 格式，confirm 接口据此校验会话归属；
// chatId/userId 不建外键（与 Memory 的 chatId 一致），草稿为确认窗口内的临时数据。
model TicketDraft {
  requestId String   @id
  chatId    String
  userId    String
  title     String
  content   String   @db.Text
  priority  String   @default("normal") // low | normal | high | urgent
  // 确认后的工单按本草稿重建（createFromDraft），故分类必须随草稿持久化
  category  String   @default("other")
  status    String   @default("pending") // pending 待确认 | approved 已确认建单 | rejected 已拒绝
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, status])
  @@index([userId])
}

// Agent 运行轨迹：每次流式回答的可观测落库记录（决策轮/工具调用/生成明细 + 分轮 token 记账），
// 供成本分析、轨迹回放与异常排查；chatId/userId 不建外键（与 Memory/TicketDraft 一致）。
model AgentRun {
  id               String   @id @default(uuid())
  chatId           String
  userId           String
  // 本次运行产出的那条 assistant 消息：打通「被评价的回答 → 当次工具轨迹」，
  // 供 eval:collect 把👎反馈连同实际检索/建单行为一起导出为评测候选用例
  messageId        String?
  model            String? // 实际使用的最终模型（决策/生成降级后的最终值）
  // 本次运行使用的提示词版本：与 messageId 一起构成
  // 「被评价的回答 → 当次提示词版本 + 工具轨迹」的归因链
  personaVersion   Int?
  // 产生本次运行的 HTTP 请求标识（X-Request-Id）：一次提问跨多次 LLM 调用与
  // 异步确认，靠它把散落的结构化日志与这条轨迹对上
  requestId        String?
  status           String   @default("completed") // completed 完整 | partial 断连中断
  rounds           Int      @default(0) // 决策循环轮数
  toolCalls        Int      @default(0) // 工具调用总次数
  sources          Int      @default(0) // RAG 命中片段数
  ticketId         String?
  ticketTitle      String?
  promptTokens     Int      @default(0) // 总计（决策循环 + 生成）
  completionTokens Int      @default(0)
  replyChars       Int      @default(0)
  totalMs          Int      @default(0)
  steps            Json? // 轨迹明细：decision/tool/generate 步骤（含分轮 token 记账）
  createdAt        DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([userId, createdAt])
  @@index([messageId])
  @@index([personaVersion])
  @@index([requestId])
}

// Agent 人设提示词的版本历史：恰有一条 status=active。
// 版本化的价值不在"能改提示词"（改代码也能），而在回答可归因 —— 没有版本号时，
// 看板看到满意度下滑却无法回答"是这周那次提示词改动导致的吗"。
model AgentPersona {
  id        String   @id @default(uuid())
  version   Int      @unique
  content   String   @db.Text
  note      String? // 变更说明：为什么出这一版（回归结论、修的哪类负例）
  status    String   @default("archived") // active 生效中 | archived 历史
  createdBy String? // 操作人（管理员）
  createdAt DateTime @default(now())

  @@index([status])
}

model Document {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  size      Int
  chunks    Int             @default(0)
  status    String          @default("indexed") // indexed, processing, failed
  department String?        // 非空 = 共享至该部门检索；空 = 仅本人可见
  createdAt DateTime        @default(now())
  chunkList KnowledgeChunk[]

  @@index([userId])
  @@index([department])
}

// 双级切块：父块（parentId 为空）内容完整，供 LLM 上下文；叶子块（parentId 非空）
// 带上下文前缀（文档名 > 章节路径）参与检索，命中后返回其父块（Small-to-Big）。
// 旧版单级块：embedding 非空且 parentId 为空 → 视为叶子，命中后返回自身。
model KnowledgeChunk {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentId    String?  // 非空 = 叶子块；空 = 父块（或旧版单级块）
  sectionPath String?  // 结构切块记录的章节路径，如 "VPN 排查 > 连接失败"
  index       Int
  content     String   @db.Text
  embedding   Json?    // 仅叶子块有值（上下文前缀+正文的向量）；父块为 NULL
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([parentId])
}

// 知识缺口台账：AI 升级掉、人工解决了的问题 = 库里缺的那篇文档。
// 清单本身每次都能从工单重算出来，落库只为了记住**人对它的处置**（成文/不打算补/注明出处），
// 所以 ticketId 唯一且同步时永不覆盖已有行 —— 坐席的决定不能被一次重算冲掉。
// 不建外键：工单可被删，删单不该抹掉"这条缺口我们补过文档"的痕迹（与 Ticket.chatId 同理）。
model KnowledgeGap {
  id            String    @id @default(uuid())
  ticketId      String    @unique
  chatId        String? // 来源会话（溯源用，可空）
  category      String
  question      String    @db.VarChar(500)
  reason        String // no_hit 库里没有 | hit_but_escalated 有却没解决 | unknown_hits 拿不到观测
  hasSolution   Boolean   @default(false) // 升级后人工是否留下了处理结论
  status        String    @default("open") // open 待补 | covered 已成文 | dismissed 不打算成文
  closedBy      String? // 处置人
  closedDocId   String? // 成文时引用的知识库文档（不建外键：文档会被重传/删除）
  closeNote     String?   @db.VarChar(500)
  closedAt      DateTime?
  firstSeenAt   DateTime  @default(now()) // 这条缺口第一次被发现的时间
  updatedAt     DateTime  @updatedAt

  @@index([status, category])
  @@index([firstSeenAt])
}

// 提示词：每用户独立的角色预设，可一键注入对话
model Prompt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  category  String   @default("通用")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// 站内通知：工单事件（新单待受理/状态变更）与 SLA 预警触达对应用户，前端轮询未读数。
// 刻意不做推送通道：桌面形态本就在线轮询，为低频事件引入第二条长连接收益有限。
// userId 不建外键（与 Memory.chatId 一致的实用取舍）：删用户不该让通知表产生级联写。
model Notification {
  id        String   @id @default(uuid())
  userId    String
  // ticket_created 新单待受理 | ticket_assigned 新指派 | ticket_status 状态变更
  // | sla_at_risk 濒临违约 | sla_breached 已违约
  type      String
  title     String
  body      String   @db.VarChar(500)
  payload   Json? // 结构化上下文（ticketId 等），供前端点击跳转
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// 对话附件：用户在会话里提交的截图/日志/配置等证据。字节落盘（与工单附件同一思路），
// 此表存元数据；chatId/uploaderId 不建外键（与 TicketDraft 一致）：删会话不该产生级联写，
// 字节清理由 deleteChat 路径显式负责。
model ChatAttachment {
  id         String   @id @default(uuid())
  chatId     String
  uploaderId String
  name       String // 原始文件名（展示与类型判断用）
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([chatId])
}

// 配置表，存储每个用户独立的 LLM provider 等可动态修改的配置项
model Setting {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String    @db.Text
  updatedAt DateTime  @updatedAt

  @@id([userId, key])
}
